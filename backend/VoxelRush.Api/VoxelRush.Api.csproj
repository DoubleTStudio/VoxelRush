<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- VR-080 metadata API: accounts, worlds/ACL, join tickets, snapshot index. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>VoxelRush.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same ticket codec the Unity dedicated server verifies with. -->
    <Compile Include="../../unity/Assets/VoxelRush/Runtime/Core/Networking/JoinTicket.cs" Link="Shared/JoinTicket.cs" />
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>
</Project>
