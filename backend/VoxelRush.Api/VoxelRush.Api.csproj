<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- VR-080 metadata API: accounts, worlds/ACL, join tickets, snapshot index. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>VoxelRush.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same ticket codec the Unity dedicated server verifies with. -->
    <Compile Include="../../unity/Assets/VoxelRush/Runtime/Core/Networking/JoinTicket.cs" Link="Shared/JoinTicket.cs" />
    <!-- ALLOC-001: the host agent's ensure response, one definition for both sides. -->
    <Compile Include="../VoxelRush.HostAgent/HostContract.cs" Link="Shared/HostContract.cs" />
    <EmbeddedResource Include="Migrations/*.sql" />
    <EmbeddedResource Include="catalog.json" LogicalName="VoxelRush.Api.catalog.json" />
    <!-- Public Apple Root CA - G3 from apple.com/certificateauthority, pinned by SHA-256 in AppleVerifier. -->
    <EmbeddedResource Include="Certificates/AppleRootCA-G3.cer" LogicalName="VoxelRush.Api.AppleRootCA-G3.cer" />
  </ItemGroup>
</Project>
